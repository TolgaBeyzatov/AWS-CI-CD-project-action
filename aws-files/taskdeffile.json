{
    "family": "vproapp-tdef",
    "containerDefinitions": [
        {
            "name": "vproapp",
            "image": "127214174680.dkr.ecr.us-east-1.amazonaws.com/actapp:latest",
            "cpu": 0,
            "logConfiguration": { 
              "logDriver": "awslogs",
              "options": { 
                "awslogs-group" : "vprofile-api",
                "awslogs-region": "us-east-1",
                "awslogs-stream-prefix": "ecs"
        }
            },
            "portMappings": [
                {                    
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            
            "essential": true,
            "environment": [
                {
                    "name": "MemcachedEndpoint",
                    "value": "vprofile-cache.6sccoa.cfg.use1.cache.amazonaws.com"
                }


            ],
            "mountPoints": [],
            "volumesFrom": [],
            "systemControls": []
        }
    ],
    "taskRoleArn": "arn:aws:iam::127214174680:role/vprofile-app-task",
    "executionRoleArn": "arn:aws:iam::127214174680:role/vprofile-task-execution-role",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "2048",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "tags": [
        {
            "key": "Project",
            "value": "vproapp-act-tdef"
        },
        {
            "key": "Environment",
            "value": "Name"  
        }
    ]
}